.page1{
    height: 50vh;
}
  
.nav{
    padding: 5vw 5vw;
}

.nav-center{
   display: none;
}

.nav-right {
    display: none;
}

.menu{
    display: inline;
    background-color: transparent;
    border:1px solid rgb(234, 234, 234);
    padding: 2;
}

.landingPage{
    height: 50vh;
}


.tagline{
    width: 80vw;
    line-height: 9vw;
}

.tagline h1{
    font-size: 10vw;
    color: #ffff;
}
.tagline h2{
    font-size: 7vw;
    color: #ffff;
}
.tagline p{
    line-height: 3vw;
    font-size: 3vw;
}
button{
    font-size: 3.5vw;
}

.page2{
    height: 100vh;
    width: 100%;
    background-color: #e9e1d4;
}
.middleText{
    height: 25vh;
}

.middleText h1{
    text-align: center;
    font-size: 3.5vw;
}
.middleText span{
    font-family: "Bella";
    font-weight: 800;
}

.designs-container{
    height: auto;
    flex-wrap: wrap;
    justify-content: center;
    padding: 0 2vw;
}

.design-box{
    height: 28vh;
    width: 45vw;
}

.page3{
    height: 80vh;
    padding: 5vw 2vw 10vw;
    margin-top: -20vw;
}
.page3-contaner{
    display: flex;
    flex-direction: column;
    padding-top: 10vw;
    gap: 3vw;
}

.page3-box1{
    width: 100%;
    height: 50%;
    padding: 2vw;
}
.page3-box1 h2{
    font-size: 5.3vw;
    color: #fff;
}


.page3-box2{
    padding: 0vw 2vw;
    width: 100%;
    color: #fff;
}
.page3-box2 h2{
    font-size: 4vw;
    line-height: 4vw;
   
}
.page3-box2 p{
    font-size: 1.9vw;
    line-height: 1.9vw;
}

.page3-rank{
    display: flex;
    gap: 3.5vw;
    padding-top: 10vw;
}
.page3-rank-wrap{
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.page3-rank-wrap h1{
    font-size: 10vw;
}
.page3-rank-wrap p{
    margin-top: -2vw;
}

.page3-bottom{
    display: none;
}

.page4{
    height: 100vh;
    width: 100%;
    margin-top: -20vh;
}

.card-tag{
    height: 0.5vh;
    width: 10vh;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    top: -3vh;
}

.content-marketing-videos{
    flex-direction: column;
    gap: 2vw;
}


.designer-text h1{
    font-size: 5.5vw;
    line-height: 5.4vw;
    text-align: center;
    padding-bottom: 1.3vw;
}
.designer-text h1 span{
    text-decoration: underline;
    color:#f6ce19;
}
.designer-text p{
    font-size: 3vw;
    line-height: 1.1vw;
    text-align: center;
}

.desinger-box{
    position: absolute;
    height: 28vh;
    width: 12vw;
    left: 15%;
    top: 25%;
    border-radius: 5px;
    overflow: hidden;
}

.video-1{
    height: 27vh;
    width: 100%;
}
.video-2{
    width: 100%;
}

